DB_HOST=db
DB_USER=wassersport
DB_PASS=secret
DB_NAME=wassersport
JWT_SECRET=change-me-in-production
PORT=3000

# Logging: trace | debug | info | warn | error | fatal  (default: info)
# Set to debug to enable SMTP + DB connection diagnostics
LOG_LEVEL=info

# Base URL used in password-reset e-mails (no trailing slash)
APP_BASE_URL=https://wassersport.example.com

# SMTP for password-reset e-mails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password
SMTP_FROM="Havelkanal Wassersport <noreply@example.com>"

# DeepL for translating dynamic content like captain announcements and calendar events
DEEPL_API_KEY=your-deepl-api-key
# Optional: override for DeepL Pro endpoint
# DEEPL_API_URL=https://api.deepl.com/v2/translate
